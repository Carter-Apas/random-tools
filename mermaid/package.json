{
  "name": "mermaid-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch server.mjs --dev",
    "start": "node server.mjs",
    "build": "vite build",
    "check": "node --check server.mjs && node --check store.mjs && node --check src/main.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "vite": "8.3.6"
  }
}
