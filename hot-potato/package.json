{
  "name": "hot-potato",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'PORT=5188 tsx watch server/index.ts' 'vite --host 0.0.0.0'",
    "start": "node dist/server/server/index.js",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "npm run build && node test/browser.mjs",
    "answers:build": "tsx scripts/build-category-packs.ts",
    "answers:check": "tsx scripts/build-category-packs.ts --check",
    "answers:fetch": "tsx scripts/fetch-category-sources.ts",
    "answers:fetch:units": "node scripts/build-unit-pack.mjs",
    "answers:propose": "tsx scripts/propose-answer.ts"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/nunito": "^5.2.0",
    "@fontsource/pixelify-sans": "^5.2.0",
    "express": "^5.1.0",
    "pluralize": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@cartercree/eslint-config": "^4.1.0",
    "@types/express": "^5.0.3",
    "@types/n3": "^1.26.6",
    "@types/node": "^24.3.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "n3": "^2.13.12",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
