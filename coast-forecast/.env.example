PORT=5180
HOST=0.0.0.0
# Optional admin password. Leave unset to choose one on the first /admin visit.
# The UI saves a salted password hash beside the configuration on the mounted host directory.
# ADMIN_PASSWORD=
# Admin settings are saved here. Mount its parent directory for persistence across container replacement.
# SETTINGS_FILE=./.data/settings.json
# Optional path to a JSON file of per-spot default overrides, relative to the process cwd.
# SPOT_CONFIG_FILE=./spots.local.json
# Optional Open-Meteo commercial subscription key; selects customer API hosts.
# OPEN_METEO_API_KEY=
