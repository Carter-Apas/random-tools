{
  "name": "coast-forecast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'PORT=5181 tsx watch --env-file-if-exists=.env server/index.ts' 'vite'",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@random-tools/mono": "file:vendor/random-tools-mono-0.2.3.tgz",
    "suncalc": "^2.1.3"
  },
  "devDependencies": {
    "@cartercree/eslint-config": "^4.1.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
