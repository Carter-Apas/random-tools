{
  "name": "@random-tools/mono",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Ayu-inspired interface foundations for Random Tools.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mono.js"
    },
    "./styles.css": "./dist/mono.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "storybook": "npm run dev",
    "build": "tsc --noEmit && storybook build --disable-telemetry",
    "build:lib": "vite build && vite build --mode browser && tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "preview": "vite preview --outDir storybook-static --host 0.0.0.0 --port 6006",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:apps": "npm run build:lib && node scripts/package-apps.mjs",
    "test:apps": "playwright test -c playwright.apps.config.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cartercree/eslint-config": "^4.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "lucide-react": "^1.70.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
